{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agents Company System Incident",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "severity",
    "detectedBy",
    "symptom",
    "openedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^inc-"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "investigating",
        "resolved"
      ]
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "detectedBy": {
      "enum": [
        "worker",
        "manager",
        "human"
      ]
    },
    "managerJobIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedWorkItemIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "symptom": {
      "type": "string",
      "minLength": 1
    },
    "rootCause": {
      "type": [
        "string",
        "null"
      ]
    },
    "fix": {
      "type": [
        "string",
        "null"
      ]
    },
    "regressionCheck": {
      "type": [
        "string",
        "null"
      ]
    },
    "prevention": {
      "type": [
        "string",
        "null"
      ]
    },
    "operatingModelChanged": {
      "type": "boolean"
    },
    "githubIssue": {
      "type": [
        "object",
        "null"
      ]
    },
    "openedAt": {
      "type": "string"
    },
    "resolvedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
