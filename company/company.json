{
  "schemaVersion": 1,
  "companyId": "agents-company",
  "name": "Agents Company",
  "description": "GitHub-native multi-agent company template",
  "mission": "Turn a human-defined mission into durable, reviewable work through Manager and Worker agents.",
  "defaultManagerJobId": "general-manager",
  "managerJobIds": [
    "general-manager"
  ],
  "controlPlane": "github",
  "schedulerPolicy": "external-bootstrap-only",
  "workItemStore": "github-issues",
  "incidentStore": "github-issues",
  "claimStore": "repository-lock-files",
  "pullRequestPolicy": "reviewable-deliverables-only",
  "github": {
    "repositoryFullName": "nomuonji/agents-company",
    "workTitlePrefix": "[Work]",
    "incidentTitlePrefix": "[Incident]"
  },
  "panel": {
    "mode": "github-pages-read-only",
    "issueSource": "github-api-public",
    "privateSnapshotPath": "panel-data/issues.json",
    "sourceBranch": "main"
  },
  "canonicalStateFiles": {
    "managers": "company/state/managers.json",
    "managerRuns": "company/state/manager-runs.json"
  }
}
